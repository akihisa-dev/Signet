cmake_minimum_required(VERSION 3.31)

set(SIGNET_BUNDLE "${CMAKE_INSTALL_PREFIX}/Signet.app")
if(DEFINED ENV{DESTDIR} AND NOT "$ENV{DESTDIR}" STREQUAL "")
  set(SIGNET_BUNDLE "$ENV{DESTDIR}${SIGNET_BUNDLE}")
endif()

if(NOT IS_DIRECTORY "${SIGNET_BUNDLE}")
  message(FATAL_ERROR "Cannot deploy plugin dependencies; app not found: ${SIGNET_BUNDLE}")
endif()

foreach(SIGNET_PLUGIN_RELATIVE_PATH IN ITEMS
    @SIGNET_REQUIRED_QT_PLUGIN_RELATIVE_PATHS@)
  set(SIGNET_PLUGIN_PATH
    "${SIGNET_BUNDLE}/Contents/PlugIns/${SIGNET_PLUGIN_RELATIVE_PATH}")
  if(NOT EXISTS "${SIGNET_PLUGIN_PATH}" OR IS_DIRECTORY "${SIGNET_PLUGIN_PATH}")
    message(FATAL_ERROR "Required Qt plugin is missing from bundle: ${SIGNET_PLUGIN_PATH}")
  endif()
endforeach()

set(SIGNET_PLUGIN_SOURCE_FILES @SIGNET_REQUIRED_QT_PLUGIN_REALPATHS@)
# A single GET_RUNTIME_DEPENDENCIES invocation is not sufficient here: a
# dependency can itself introduce a non-system library which is not reported
# until that library is scanned.  Walk the dependency graph explicitly so the
# install does not need a growing list of special-case libraries.
set(SIGNET_DEPENDENCY_FRONTIER ${SIGNET_PLUGIN_SOURCE_FILES})
set(SIGNET_SCANNED_DEPENDENCY_INPUTS)
set(SIGNET_PLUGIN_DEPENDENCIES)
while(SIGNET_DEPENDENCY_FRONTIER)
  set(SIGNET_DEPENDENCY_INPUTS)
  foreach(SIGNET_DEPENDENCY_INPUT IN LISTS SIGNET_DEPENDENCY_FRONTIER)
    list(FIND SIGNET_SCANNED_DEPENDENCY_INPUTS "${SIGNET_DEPENDENCY_INPUT}" SIGNET_GLOBAL_INPUT_INDEX)
    if(SIGNET_GLOBAL_INPUT_INDEX EQUAL -1)
      list(APPEND SIGNET_SCANNED_DEPENDENCY_INPUTS "${SIGNET_DEPENDENCY_INPUT}")
      list(APPEND SIGNET_DEPENDENCY_INPUTS "${SIGNET_DEPENDENCY_INPUT}")
    endif()
  endforeach()
  if(NOT SIGNET_DEPENDENCY_INPUTS)
    break()
  endif()

  file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES ${SIGNET_DEPENDENCY_INPUTS}
    DIRECTORIES @SIGNET_QT_RUNTIME_DIRECTORIES@
    RESOLVED_DEPENDENCIES_VAR SIGNET_RESOLVED_DEPENDENCIES
    UNRESOLVED_DEPENDENCIES_VAR SIGNET_UNRESOLVED_DEPENDENCIES
    CONFLICTING_DEPENDENCIES_PREFIX SIGNET_CONFLICTING_DEPENDENCIES
  )

  if(SIGNET_UNRESOLVED_DEPENDENCIES)
    message(FATAL_ERROR
      "Unresolved dependencies of required Qt plugins: ${SIGNET_UNRESOLVED_DEPENDENCIES}")
  endif()

  set(SIGNET_NEXT_DEPENDENCY_FRONTIER)
  foreach(SIGNET_DEPENDENCY IN LISTS SIGNET_RESOLVED_DEPENDENCIES)
    if(SIGNET_DEPENDENCY MATCHES "^/System/|^/usr/lib/")
      continue()
    endif()
    list(APPEND SIGNET_PLUGIN_DEPENDENCIES "${SIGNET_DEPENDENCY}")
    list(APPEND SIGNET_NEXT_DEPENDENCY_FRONTIER "${SIGNET_DEPENDENCY}")
  endforeach()
  list(REMOVE_DUPLICATES SIGNET_PLUGIN_DEPENDENCIES)
  list(REMOVE_DUPLICATES SIGNET_NEXT_DEPENDENCY_FRONTIER)
  set(SIGNET_DEPENDENCY_FRONTIER ${SIGNET_NEXT_DEPENDENCY_FRONTIER})
endwhile()

foreach(SIGNET_DEPENDENCY IN LISTS SIGNET_PLUGIN_DEPENDENCIES)
  if(SIGNET_DEPENDENCY MATCHES "^/System/|^/usr/lib/")
    continue()
  endif()
  file(INSTALL "${SIGNET_DEPENDENCY}"
    DESTINATION "${CMAKE_INSTALL_PREFIX}/Signet.app/Contents/Frameworks"
    FOLLOW_SYMLINK_CHAIN)
endforeach()
